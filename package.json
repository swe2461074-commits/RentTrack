{
  "name": "renttrack",
  "version": "1.0.0",
  "description": "RentTrack - эд зүйлс түрээсийн бизнесийг нэг сайтаас удирдах SPA (Vanilla JS + Bulma + Sass)",
  "scripts": {
    "sass": "sass --watch src/scss/main.scss src/css/main.css",
    "build:css": "sass src/scss/main.scss src/css/main.css --no-source-map --quiet-deps",
    "serve": "npx http-server src -p 8080 -c-1"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bulma": "^1.0.4",
    "sass": "^1.108.2"
  }
}
